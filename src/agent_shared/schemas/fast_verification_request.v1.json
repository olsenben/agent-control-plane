{
  "$defs": {
    "VerifierSelection": {
      "additionalProperties": false,
      "description": "Deterministic fast-verifier binding chosen by control plane.",
      "properties": {
        "command_ref": {
          "title": "Command Ref",
          "type": "string"
        },
        "display_name": {
          "title": "Display Name",
          "type": "string"
        },
        "output_limit_bytes": {
          "default": 1048576,
          "minimum": 1,
          "title": "Output Limit Bytes",
          "type": "integer"
        },
        "provenance_hash": {
          "default": "",
          "title": "Provenance Hash",
          "type": "string"
        },
        "schema_version": {
          "const": "verifier_selection.v1",
          "default": "verifier_selection.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "scope": {
          "const": "fast",
          "default": "fast",
          "title": "Scope",
          "type": "string"
        },
        "source": {
          "enum": [
            "eval_manifest",
            "registry"
          ],
          "title": "Source",
          "type": "string"
        },
        "timeout_s": {
          "default": 120,
          "minimum": 1,
          "title": "Timeout S",
          "type": "integer"
        },
        "verifier_id": {
          "title": "Verifier Id",
          "type": "string"
        }
      },
      "required": [
        "verifier_id",
        "source",
        "command_ref",
        "display_name"
      ],
      "title": "VerifierSelection",
      "type": "object"
    }
  },
  "$id": "https://ai-sdlc-lab.local/schemas/fast_verification_request.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Request to run one bounded fast verification attempt.",
  "properties": {
    "attempt_number": {
      "minimum": 0,
      "title": "Attempt Number",
      "type": "integer"
    },
    "patch_hash": {
      "title": "Patch Hash",
      "type": "string"
    },
    "schema_version": {
      "const": "fast_verification_request.v1",
      "default": "fast_verification_request.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "session_id": {
      "title": "Session Id",
      "type": "string"
    },
    "snapshot_sha": {
      "title": "Snapshot Sha",
      "type": "string"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "verifier_selection": {
      "$ref": "#/$defs/VerifierSelection"
    }
  },
  "required": [
    "task_id",
    "session_id",
    "snapshot_sha",
    "patch_hash",
    "verifier_selection",
    "attempt_number"
  ],
  "title": "fast_verification_request.v1",
  "type": "object"
}
