{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-sdlc-lab.local/schemas/evidence_provider.v1.schema.json",
  "title": "evidence_provider.v1",
  "description": "Stable replaceable evidence-provider SPI. Extends evidence_adapter.v1 with provider identity, requirement class, repository scope, version, and timeout. Trust is configured, never inferred from JSON/SARIF/report format. Providers do not admit patches and do not retune frozen C.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider_id",
    "provider_identity",
    "adapter_id",
    "adapter_class",
    "producer_id",
    "producer_version",
    "version",
    "interchange",
    "evidence_types",
    "trust_class",
    "requirement_class",
    "repository_scope",
    "timeout_ms",
    "trust_inferred_from_format",
    "binding_required",
    "baseline_and_candidate_required",
    "imports_admission_controller",
    "llm_parser",
    "hidden_gold",
    "learned_judge"
  ],
  "properties": {
    "schema_version": {
      "const": "evidence_provider.v1"
    },
    "provider_id": {
      "$ref": "#/$defs/nonempty"
    },
    "provider_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principal_kind", "identity_id"],
      "properties": {
        "principal_kind": {
          "const": "EVIDENCE_PROVIDER"
        },
        "identity_id": {
          "$ref": "#/$defs/nonempty"
        },
        "issuer": {
          "type": ["string", "null"]
        },
        "namespace": {
          "type": ["string", "null"]
        }
      }
    },
    "adapter_id": {
      "$ref": "#/$defs/nonempty"
    },
    "adapter_class": {
      "enum": [
        "SAST",
        "SECURITY_TEST",
        "SECURITY_POC",
        "TASK_EVIDENCE",
        "SECRET_SCAN",
        "DEPENDENCY_SCAN",
        "CONFIG_POLICY",
        "FUNCTIONAL_TEST",
        "CI_VERDICT",
        "OTHER_TYPED"
      ]
    },
    "producer_id": {
      "$ref": "#/$defs/nonempty"
    },
    "producer_version": {
      "$ref": "#/$defs/nonempty"
    },
    "version": {
      "$ref": "#/$defs/nonempty"
    },
    "interchange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "version", "vendor_neutral"],
      "properties": {
        "format": {
          "$ref": "#/$defs/nonempty"
        },
        "version": {
          "$ref": "#/$defs/nonempty"
        },
        "vendor_neutral": {
          "type": "boolean"
        },
        "native_fallback": {
          "type": ["string", "null"]
        },
        "notes": {
          "type": ["string", "null"]
        }
      }
    },
    "evidence_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "FUNCTIONAL_TEST",
          "SECURITY_TEST",
          "SECURITY_POC",
          "SAST",
          "SECRET_SCAN",
          "DEPENDENCY_SCAN",
          "CONFIG_POLICY",
          "TASK_REQUIREMENT",
          "SECURITY_FINDING",
          "REPOSITORY_POLICY",
          "OWNERSHIP_POLICY",
          "SEMANTIC_RELATION",
          "CI_VERDICT",
          "OTHER_TYPED"
        ]
      }
    },
    "trust_class": {
      "description": "Configured trust. Must not be derived from interchange format.",
      "enum": [
        "AUTHORITATIVE_CONTROL_PLANE",
        "AUTHORITATIVE_CI",
        "CONFIGURED_SECURITY_TOOL",
        "TASK_SYSTEM",
        "REPOSITORY_METADATA",
        "ADVISORY_TOOL",
        "ACTOR_PROVIDED",
        "UNKNOWN"
      ]
    },
    "requirement_class": {
      "enum": [
        "REQUIRED_PROVIDER",
        "OPTIONAL_PROVIDER"
      ]
    },
    "repository_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_kind"],
      "properties": {
        "scope_kind": {
          "enum": [
            "ALL_CONFIGURED",
            "REPOSITORY_LIST"
          ]
        },
        "repositories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonempty"
          }
        }
      }
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 1
    },
    "trust_inferred_from_format": {
      "const": false
    },
    "binding_required": {
      "type": "boolean"
    },
    "baseline_and_candidate_required": {
      "type": "boolean"
    },
    "imports_admission_controller": {
      "const": false
    },
    "llm_parser": {
      "const": false
    },
    "hidden_gold": {
      "const": false
    },
    "learned_judge": {
      "const": false
    },
    "missing_output_status": {
      "enum": [
        "TOOL_FAILURE",
        "INCOMPLETE"
      ]
    },
    "authoritative_when_actor_provided": {
      "const": false
    },
    "notes": {
      "type": ["string", "null"]
    }
  },
  "$defs": {
    "nonempty": {
      "type": "string",
      "minLength": 1
    }
  }
}
