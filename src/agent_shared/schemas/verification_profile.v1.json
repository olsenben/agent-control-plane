{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-sdlc-lab.local/schemas/verification_profile.v1.schema.json",
  "title": "verification_profile.v1",
  "description": "Repository verification profile. Supplies required CI workflow identity so required_workflows is not anonymously empty. Does not weaken exact-SHA verification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "repository",
    "required_workflows"
  ],
  "properties": {
    "schema_version": {
      "const": "verification_profile.v1"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "required_workflows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["workflow_id", "path"],
        "properties": {
          "workflow_id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "display_name": {
            "type": "string"
          },
          "source": {
            "const": "verification_profile"
          }
        }
      }
    },
    "notes": {
      "type": ["string", "null"]
    }
  }
}
