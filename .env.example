# Copy to .env on CT103; never commit .env
GITEA_BASE_URL=https://git.ham-sup-lo.com
GITEA_BOT_TOKEN=
GITEA_WEBHOOK_SECRET=
# Exact owner/repo, owner/* for all repos under an owner, or * for all
GITEA_ALLOWED_REPOS=ai-sdlc-lab/*

# Container path (mount target)
AGENT_STATE_ROOT=/data/agent-state
# Host path for docker-compose volume bind
AGENT_STATE_HOST_PATH=/mnt/agent-state

REDIS_URL=redis://redis:6379/0

# Tailscale Ollama endpoints (offline laptops -> /readyz status degraded)
MODEL_3080_BASE_URL=http://100.107.20.28:11434
MODEL_3080_NAME=
MODEL_3080_API_KEY=
MODEL_2070_BASE_URL=http://100.125.235.54:11434
MODEL_2070_NAME=
MODEL_2070_API_KEY=

# Per-tier external OpenAI-compatible endpoints (/v1)
MODEL_3080_EXTERNAL_BASE_URL=
MODEL_3080_EXTERNAL_NAME=
MODEL_3080_EXTERNAL_API_KEY=
MODEL_2070_EXTERNAL_BASE_URL=
MODEL_2070_EXTERNAL_NAME=
MODEL_2070_EXTERNAL_API_KEY=

# Per-tier fallback when primary unreachable (requires MODEL_FALLBACK_ENABLED=true)
MODEL_3080_FALLBACK_BASE_URL=
MODEL_3080_FALLBACK_NAME=
MODEL_3080_FALLBACK_API_KEY=
MODEL_2070_FALLBACK_BASE_URL=
MODEL_2070_FALLBACK_NAME=
MODEL_2070_FALLBACK_API_KEY=

# Comma-separated roles that prefer external tier endpoints when configured
MODEL_EXTERNAL_ROLES=
MODEL_FALLBACK_ENABLED=true

MODEL_HEALTH_TIMEOUT_SECONDS=3
MODEL_HEALTH_REQUIRED_FOR_READYZ=false
