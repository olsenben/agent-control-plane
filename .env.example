# Copy to .env on CT103; never commit .env
GITEA_BASE_URL=https://git.ham-sup-lo.com
GITEA_BOT_TOKEN=
GITEA_WEBHOOK_SECRET=
# Exact owner/repo, owner/* for all repos under an owner, or * for all
GITEA_ALLOWED_REPOS=ai-sdlc-lab/*
# Homelab human approvers for org-owned repos (comma-separated Gitea logins)
GITEA_APPROVER_LOGINS=olsenben

# Container path (mount target)
AGENT_STATE_ROOT=/data/agent-state
# Host path for docker-compose volume bind
AGENT_STATE_HOST_PATH=/mnt/agent-state
AGENT_CACHE_HOST_PATH=/mnt/agent-cache
# Deploy user's HTTP git credentials (configure-deploy-git-https.sh on CT103)
GIT_CREDENTIALS_HOST_PATH=/home/deploy/.git-credentials

# CT103 compose network (default on control host)
REDIS_URL=redis://redis:6379/0
# CT104 on steelleg — override to CT103 Tailscale IP, e.g. redis://100.96.53.125:6379/0

# Tailscale Ollama endpoints (offline laptops -> /readyz status degraded)
MODEL_3080_BASE_URL=http://100.107.20.28:11434
MODEL_3080_NAME=
MODEL_3080_API_KEY=
MODEL_2070_BASE_URL=http://100.125.235.54:11434
MODEL_2070_NAME=
MODEL_2070_API_KEY=

# Per-tier external OpenAI-compatible endpoints (/v1)
MODEL_3080_EXTERNAL_BASE_URL=
MODEL_3080_EXTERNAL_NAME=
MODEL_3080_EXTERNAL_API_KEY=
MODEL_2070_EXTERNAL_BASE_URL=
MODEL_2070_EXTERNAL_NAME=
MODEL_2070_EXTERNAL_API_KEY=

# Per-tier fallback when primary unreachable (requires MODEL_FALLBACK_ENABLED=true)
MODEL_3080_FALLBACK_BASE_URL=
MODEL_3080_FALLBACK_NAME=
MODEL_3080_FALLBACK_API_KEY=
MODEL_2070_FALLBACK_BASE_URL=
MODEL_2070_FALLBACK_NAME=
MODEL_2070_FALLBACK_API_KEY=

# Comma-separated roles that prefer external tier endpoints when configured
MODEL_EXTERNAL_ROLES=
MODEL_FALLBACK_ENABLED=true

# V6 T04 — CT103 LiteLLM gateway (optional; empty = direct MODEL_* endpoints)
# MODEL_GATEWAY_BASE_URL=http://litellm:4000/v1
# MODEL_GATEWAY_API_KEY=sk-litellm-homelab
# MODEL_GATEWAY_MODEL_MAP=planner=primary-generator,reviewer=primary-generator,fixer=primary-generator,rlm=primary-generator,worker=context-controller
# REPO_EXTERNAL_MODEL_POLICY=ai-sdlc-lab/*
# MODEL_CODE_HANDLING_ROLES=fixer,rlm
# MODEL_BUDGET_MAX_TOTAL=5
# MODEL_BUDGET_MAX_ROUTES=2
# MODEL_BUDGET_MAX_INFRA=3
# MODEL_BUDGET_MAX_QUALITY=1
# MODEL_BUDGET_MAX_SCHEMA_REPAIR=1

MODEL_HEALTH_TIMEOUT_SECONDS=3
MODEL_HEALTH_REQUIRED_FOR_READYZ=false

# V10 T00.5 — recursive controller arm. Empty defers to config/recursive_context.yaml
# (deterministic / C0). Set to "model" only for a C1 experiment arm.
# RECURSIVE_CONTEXT_CONTROLLER_BACKEND=

# Restrict public API to webhook + health when true
ENFORCE_PUBLIC_SURFACE_RESTRICTION=false

# CT104 worker host: use .env.ct104.example instead of copying this file wholesale.

# CT104 worker paths (steelleg)
AGENT_RUNS_DIR=/mnt/agent-runs
AGENT_RUNS_HOST_PATH=/mnt/agent-runs
AGENT_CACHE_DIR=/mnt/agent-cache
AGENT_CACHE_HOST_PATH=/mnt/agent-cache
GIT_RO_KEY_PATH=/run/secrets/git_ro_key

# CT104 must NOT hold GITEA_AGENT_TOKEN / GITEA_BOT_TOKEN (V4.1.1).
# SHA-256 hex of known write PATs (comma-separated). Required when
# git-credentials is mounted; never put the token itself here.
# CT104_FORBIDDEN_GIT_TOKEN_SHA256=
# Comments + push/PR are CT103-only (publish-broker + gitea_comments).

# Slice 6D2 / V4.1.1 — CT103 publish brokerage (default off until cutover)
# FIX_REMOTE_PUBLISH_ENABLED=false

# Observatory auth (V6 T03 / V8 T04 / V9 T05) — fail closed by default
# OBSERVE_REQUIRE_AUTH=true
# OBSERVE_SHARED_TOKEN=
# After human registers a Gitea OAuth app (see docs/slice-v9-t05-gitea-oauth-shell.md,
# which supersedes the V8 T04 prep doc docs/slice-v8-t04-observatory-oauth.md):
# OBSERVE_OAUTH_CLIENT_ID=
# OBSERVE_OAUTH_CLIENT_SECRET=
# OBSERVE_OAUTH_REDIRECT_URI=http://192.168.4.62:8080/observe/oauth/callback
# OBSERVE_OAUTH_SCOPE=
# User access tokens / PATs with repo read also work as Authorization: Bearer <token>
# V9 T05 session/state cookie tuning (defaults are production-safe; do not
# disable OBSERVE_COOKIE_SECURE except for plain-HTTP local dev):
# OBSERVE_COOKIE_SECURE=true
# OBSERVE_SESSION_TTL_SECONDS=43200
# OBSERVE_OAUTH_STATE_TTL_SECONDS=600

# Slice 6E — CT102 CI observe/aggregate (CT103; default off)
# FIX_CI_OBSERVE_ENABLED=false
# FIX_CI_REQUIRE_MATRIX_MATCH=true
# FIX_CI_REPO_DEFAULT_WORKFLOW=.gitea/workflows/ci.yaml
# Optional: limit graph snapshot to specific repos (comma-separated). Default: all in config/projects.yaml
# GRAPH_SNAPSHOT_REPOS=ai-sdlc-lab/agent-control-plane
# Platform-owned execution strategy (V1). Repo config cannot override engine selection.
# EXECUTION_STRATEGY_PATH=/path/to/execution_strategy.yml
# Use official for Spike 1 read-only candidate runs (requires MODEL_3080_BASE_URL):
# MODEL_ROUTING_POLICY=official

# Slice 5.6a / 6F.2 — sandbox pin (required match for repair_allowed; keep repair off until strong)
SANDBOX_BACKEND=srt
SANDBOX_EXPECTED_POLICY_HASH=5de9f107fc05367e849f893c815efd18
SANDBOX_REQUIRE_ATTESTATION=true
# FIX_CI_REPAIR_ENABLED=false
# FIX_CI_FAILURE_EVIDENCE_ENABLED=false
# V4.1.1 PR4 — empty allowlist denies all; no wildcards; lint class default
# FIX_CI_REPAIR_ALLOWED_REPOS=
# FIX_CI_REPAIR_ALLOWED_CLASSES=lint_failure
# FIX_CI_REPAIR_PUBLISH_ENABLED=false
# Staged enable example (ops only):
# FIX_CI_REPAIR_ALLOWED_REPOS=ai-sdlc-lab/agent-control-plane
# FIX_CI_REPAIR_ALLOWED_CLASSES=lint_failure
# FIX_CI_REPAIR_PUBLISH_ENABLED=false
