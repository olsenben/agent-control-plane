# Copy to .env on CT104 (agentworker / steelleg). Never commit .env.
#   cp .env.ct104.example .env
# Edit values, then:
#   docker compose -f docker-compose.ct104.yml up -d --build
#
# CT103 uses .env.example instead — do not copy CT103 secrets here.

# --- Redis (CT103 control plane) ---
# CT103 Tailscale IP (agentcontrol). Verify: redis-cli -h <ip> ping
REDIS_URL=redis://100.96.53.125:6379/0

# --- Shared agent-state (NFS/bind from CT103) ---
# Container paths (fixed by docker-compose.ct104.yml)
AGENT_STATE_ROOT=/data/agent-state
AGENT_RUNS_DIR=/mnt/agent-runs
AGENT_CACHE_DIR=/mnt/agent-cache
# Host bind-mount sources on CT104
AGENT_STATE_HOST_PATH=/mnt/agent-state
AGENT_RUNS_HOST_PATH=/mnt/agent-runs
AGENT_CACHE_HOST_PATH=/mnt/agent-cache

# --- Gitea (worker-report comments only) ---
# Use a URL CT104 can reach (LAN HTTP avoids NPM cert issues on workers).
GITEA_BASE_URL=http://192.168.4.60:3000
# PAT for bot user; scope: write:issue only (see docs/ct104.md)
GITEA_AGENT_TOKEN=
GITEA_AGENT_COMMENT_ENABLED=false

# --- Git clone (worker-rlm-root) ---
# Host path to deploy user's git-credentials (from configure-deploy-git-https.sh).
# docker-compose.ct104.yml mounts this into the container for HTTP(S) clone (no SSH :22).
GIT_CREDENTIALS_HOST_PATH=/home/deploy/.git-credentials
# Legacy SSH key path (unused when repo URLs are HTTP in config/projects.yaml)
GIT_RO_KEY_PATH=/run/secrets/git_ro_key

# --- RLM engine ---
# fake = inspect MVP, no model calls
# official = read-only inspect with Tailscale Ollama (requires MODEL_* below)
MODEL_ROUTING_POLICY=fake

# --- Model endpoints (only when MODEL_ROUTING_POLICY=official) ---
# OpenAI-compatible /v1 URLs over Tailscale. No API key needed for local Ollama.
# Do not put GITEA_BOT_TOKEN, GITEA_WEBHOOK_SECRET, or GITEA_ALLOWED_REPOS here.
MODEL_3080_BASE_URL=http://100.107.20.28:11434
MODEL_3080_NAME=
MODEL_3080_API_KEY=
MODEL_2070_BASE_URL=http://100.125.235.54:11434
MODEL_2070_NAME=
MODEL_2070_API_KEY=

# Optional platform execution strategy (defaults to config/execution_strategy.yml in image)
# EXECUTION_STRATEGY_PATH=/path/to/execution_strategy.yml

# --- Sandbox (Slice 5.6a / 6F.2 gate) ---
# Must match agent_control.aci.backends.probes.policy_hash() for repair_allowed.
SANDBOX_BACKEND=srt
SANDBOX_EXPECTED_POLICY_HASH=5de9f107fc05367e849f893c815efd18
SANDBOX_REQUIRE_ATTESTATION=true
# Do NOT set FIX_CI_REPAIR_ENABLED / FIX_CI_OBSERVE_ENABLED / FIX_CI_FAILURE_EVIDENCE_ENABLED
# on CT104. Those are CT103 dispatch gates. compose forces FIX_CI_REPAIR_ENABLED=false;
# a true value without observe+evidence crashes Settings() and restart-loops all workers.
